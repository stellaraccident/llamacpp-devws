# llama.cpp HRX workspace environment.

export LLAMACPP_DEVWS="$PWD"
export LLAMACPP_DEVWS_CACHE_DIR="$PWD/cache"

export ROCM_PATH="$PWD/rocm"
export GGML_HRX_ROCM_PATH="$ROCM_PATH"

export HRX_SYSTEM_SOURCE="$PWD/sources/hrx-system"
export HRX_DEMOS_SOURCE="$PWD/sources/hrx-demos"
export LLAMA_CPP_SOURCE="$PWD/sources/llama.cpp"

export BAZELISK_HOME="$PWD/programs/bazel/cache"
export USE_BAZEL_VERSION="9.1.0"

path_prepend() {
  local var_name="$1"
  local path_value="$2"

  [ -d "$path_value" ] || return 0
  eval "case \":\${$var_name:-}:\" in
    *\":$path_value:\"*) ;;
    *) export $var_name=\"$path_value\${$var_name:+:\$$var_name}\" ;;
  esac"
}

path_prepend PATH "$PWD/tools"
path_prepend PATH "$PWD/programs/bazel/bin"
path_prepend PATH "$ROCM_PATH/bin"
path_prepend PATH "$ROCM_PATH/lib/llvm/bin"

path_prepend LD_LIBRARY_PATH "$ROCM_PATH/lib"
path_prepend LD_LIBRARY_PATH "$ROCM_PATH/lib64"
path_prepend LD_LIBRARY_PATH "$ROCM_PATH/lib/rocm_sysdeps/lib"

if [ ! -f "$PWD/.venv/bin/activate" ]; then
  "${PYTHON:-python3}" -m venv "$PWD/.venv"
fi

source "$PWD/.venv/bin/activate"

watch_file rocm
