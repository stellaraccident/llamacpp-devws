amdgpu.target<gfx1100> @target

low.kernel.def target(@target) workgroup_size(1, 1, 1) @min_store() asm<amdgpu.rdna3.core> {
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %value = v_mov_b32 1065353216
  %zero = v_mov_b32 0
  global_store_b32_saddr %zero, %value, %output_view
  return
}

check.case @case_min_store {
  %dst = check.generate.fill value(0.0) : tensor<1xf32>
  %expected = check.generate.fill value(1.0) : tensor<1xf32>
  func.call @min_store(%dst) : (tensor<1xf32>)
  check.expect.close actual(%dst) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1xf32>
  check.return
}

check.benchmark<@case_min_store> @bench_min_store
