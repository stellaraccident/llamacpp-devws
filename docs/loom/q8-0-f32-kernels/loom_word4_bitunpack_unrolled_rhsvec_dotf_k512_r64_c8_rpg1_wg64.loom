  %next_0_0 = vector.dotf %q_scaled_0_0, %rhs_0_0, %acc_init_0 : vector<4xf32>, vector<4xf32>, f32
  %block_unroll_step_0_1 = index.constant 8 : index
  %block_idx_raw_0_1 = index.add %block_slot, %block_unroll_step_0_1 : index
