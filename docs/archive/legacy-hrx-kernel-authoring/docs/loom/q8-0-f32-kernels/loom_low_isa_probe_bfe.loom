amdgpu.target<gfx1100> @target

low.kernel.def target(@target) workgroup_size(1, 1, 1) @probe_bfe() asm<amdgpu.rdna3.core> {
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %word = v_mov_b32 4278190335
  %lo = v_bfe_i32 %word, 0, 8
  %zero = v_mov_b32 0
  global_store_b32_saddr %zero, %lo, %output_view
  return
}
