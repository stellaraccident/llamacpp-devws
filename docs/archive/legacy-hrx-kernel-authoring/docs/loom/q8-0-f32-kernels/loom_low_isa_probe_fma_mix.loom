amdgpu.target<gfx1100> @target

low.kernel.def target(@target) workgroup_size(1, 1, 1) @probe_fma_mix() asm<amdgpu.rdna3.core> {
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %scale_bits = v_mov_b32 15360
  %q = v_mov_b32 1065353216
  %scaled = v_fma_mix_f32 %scale_bits, %q, 0
  %zero = v_mov_b32 0
  global_store_b32_saddr %zero, %scaled, %output_view
  return
}
